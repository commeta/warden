#!/usr/sbin/nft -f
#
# Warden manages its own nftables table (inet warden) at runtime: it creates
# the table on the first block and adds/removes entries with kernel timeouts,
# so nothing has to be cleaned up if the daemon stops and other firewall tools
# (ufw, firewalld, docker) are left untouched. Blocks are added in batches,
# one transaction each.
#
# This file is only for operators who want the table to exist independently of
# the daemon (e.g. to pre-seed a permanent blocklist). Loading it is optional.
#
#   nft -f /usr/share/warden/warden.nft
#
# The names here MUST match [actions.firewall] in warden.toml: set_v4, set_v6
# and "<set_v6>_<ipv6_prefix>" for IPv6 networks (blocklist6_64 by default).
# The sets are plain hash sets (no "flags interval"): a set holds single
# addresses, and the network set holds network addresses, which the rule masks
# the source address to. An interval set would make every nft call read all of
# its elements (0.33 s per call at 45 000 networks).

table inet warden {
    set blocklist4 {
        type ipv4_addr
        flags timeout
        size 262144
        # Pre-seed permanent blocks of single addresses here if desired:
        # elements = { 203.0.113.7, 198.51.100.9 }
    }

    # Single IPv6 addresses: a block narrowed to one address (its /64 holds
    # an allowlisted address or an administrator's SSH session) or a manual
    # `wardenctl block 2001:db8::7`.
    set blocklist6 {
        type ipv6_addr
        flags timeout
        size 262144
    }

    # IPv6 networks of ipv6_prefix bits (64), stored as the network address:
    # `wardenctl block 2001:db8:aa:1::/64` adds 2001:db8:aa:1::.
    set blocklist6_64 {
        type ipv6_addr
        flags timeout
        size 262144
        # elements = { 2001:db8:aa:1:: }
    }

    chain input {
        # priority -10: runs before the default filter hook so blocked traffic
        # is dropped before any ACCEPT rule in the main ruleset can match.
        type filter hook input priority filter - 10; policy accept;
        ip  saddr @blocklist4 counter drop comment "warden blocklist"
        ip6 saddr @blocklist6 counter drop comment "warden blocklist"
        ip6 saddr & ffff:ffff:ffff:ffff:: @blocklist6_64 counter drop comment "warden blocklist /64"
    }
}
