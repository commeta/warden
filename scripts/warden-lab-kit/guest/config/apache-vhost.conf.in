<VirtualHost 127.0.0.1:8080>
    ServerName warden-lab.test
    DocumentRoot /var/www/warden-lab/public

    <Directory /var/www/warden-lab/public>
        Options -Indexes +FollowSymLinks
        AllowOverride None
        Require all granted
        DirectoryIndex index.php index.html
    </Directory>

    # FIM can observe writable upload fixtures; never execute scripts from uploads.
    <Directory /var/www/warden-lab/public/uploads>
        Options -Indexes -ExecCGI -FollowSymLinks
        AllowOverride None
        <FilesMatch "(?i)\.(php[0-9]*|phtml|pht|phar|cgi|pl|sh|py|rb|jsp|asp|aspx|shtml)$">
            Require all denied
        </FilesMatch>
    </Directory>

    # Only nginx on loopback is trusted to provide X-Forwarded-For.
    RemoteIPHeader X-Forwarded-For
    RemoteIPInternalProxy 127.0.0.1
    LogFormat "%a %l %u %t \"%r\" %>s %b \"%{Referer}i\" \"%{User-Agent}i\"" lab_combined
    CustomLog /var/log/apache2/access.log lab_combined
    ErrorLog /var/log/apache2/error.log
    LogLevel warn

    # PHP runs in mod_php. No proxy_fcgi/PHP-FPM in this configuration.
    php_admin_flag display_errors Off
    php_admin_flag log_errors On
    php_admin_value error_log /var/log/warden-lab/php-error.log
    Header always set X-Content-Type-Options "nosniff"
</VirtualHost>
