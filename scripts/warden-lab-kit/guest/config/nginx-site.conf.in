# Bind only to loopback; the test site is not exposed on network interfaces.
log_format warden_lab '$remote_addr - $remote_user [$time_local] "$request" '
                     '$status $body_bytes_sent "$http_referer" "$http_user_agent"';
access_log /var/log/nginx/access.log warden_lab;

server {
    listen {{LAB_IP}}:80;
    server_name warden-lab.test _;
    server_tokens off;
    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Do not trust a client-supplied X-Forwarded-For chain in the lab.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        proxy_buffering on;
    }
}

server {
    listen {{LAB_IP}}:443 ssl;
    server_name warden-lab.test _;
    server_tokens off;
    ssl_certificate /etc/nginx/ssl/warden-lab.crt;
    ssl_certificate_key /etc/nginx/ssl/warden-lab.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:wardenlab:10m;
    ssl_session_timeout 10m;
    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        proxy_buffering on;
    }
}
