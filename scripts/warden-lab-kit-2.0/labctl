#!/usr/bin/env python3
"""labctl — the Warden Lab Kit 2.0 entry point.

A thin launcher: it makes the kit directory importable and hands off to
``lab.cli``. No third-party dependencies; Python 3.11+ (Ubuntu 24.04 ships
3.12).
"""

import os
import sys

if sys.version_info < (3, 11):
    sys.stderr.write("labctl needs Python 3.11+ (Ubuntu 24.04 ships 3.12)\n")
    raise SystemExit(1)

_HERE = os.path.dirname(os.path.abspath(__file__))
if _HERE not in sys.path:
    sys.path.insert(0, _HERE)

from lab.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
