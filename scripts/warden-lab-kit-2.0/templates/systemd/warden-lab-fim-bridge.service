[Unit]
Description=Warden Lab upload FIM compatibility bridge (inotify to Warden scan)
After=wardend.service
Requires=wardend.service
ConditionPathExists=@CONFIG@

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/python3 @SCRIPT@ --config @CONFIG@
Restart=on-failure
RestartSec=2
TimeoutStopSec=10

# The bridge is read-only: inotify observes upload directory inodes and asks
# the Warden control socket to scan the matching site. Service namespaces stay
# enabled; unlike fanotify mount marks, the inotify inode watch spans them.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# Upload directories are 0750 and owned by individual service accounts.
# The bridge needs traversal/read access to place inotify watches, but never
# needs write access or CAP_SYS_ADMIN.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH

[Install]
WantedBy=multi-user.target
