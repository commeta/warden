[Unit]
Description=Warden Lab Kit nftables barrier (inet lab_filter)
After=network-pre.target
Before=network.target nginx.service apache2.service
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Load only our table; never the whole ruleset. The rules file begins with
# `destroy table inet lab_filter`, which is idempotent even on first boot.
# Avoid a separate pre-delete: nft emits a noisy error when the table is absent.
ExecStart=/usr/sbin/nft -f /etc/warden-lab/lab_filter.nft
ExecStop=-/usr/sbin/nft delete table inet lab_filter
ExecReload=/usr/sbin/nft -f /etc/warden-lab/lab_filter.nft

[Install]
WantedBy=multi-user.target
